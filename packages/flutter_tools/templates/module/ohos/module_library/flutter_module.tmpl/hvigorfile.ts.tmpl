import { harTasks } from '@ohos/hvigor-ohos-plugin';
import fs from 'fs';
import path from 'path';

function parsePropertiesFile(file) {
    if (!fs.existsSync(file)) {
        throw new Error(`check if properties file:(${file}) exist ?`);
    }

    let properties = {};
    let content = fs.readFileSync(file, 'utf-8');
    const lines = content.split('\n');
    for (let line of lines) {
        line = line.trim();
        if (line.startsWith('#') || line.length === 0 || !line.includes('=')) {
            continue;
        }
        let [key, value] = line.split('=');
        properties[key] = value;
    }
    return properties;
}
const properties = parsePropertiesFile(path.join(__dirname, '..', 'local.properties'));
const flutterSdkPath = properties['flutter.sdk'];

const { plugins } = require(path.join(flutterSdkPath, 'packages', 'flutter_tools', 'hvigor', 'flutter.ts'));

export default {
    system: harTasks,  /* Built-in plugin of Hvigor. It cannot be modified. */
    plugins: plugins,  /* Custom plugin to extend the functionality of Hvigor. */
}
